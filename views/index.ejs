<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <link rel="stylesheet" href="style.css" />
  <title>Genshin Calendar</title>
</head>

<body>
  <div class="calendar">
    <div class="calendar__header">
      <button class="calendar__button">&lt;</button>
      <h2 class="calendar__title">2026. 7</h2>
      <button class="calendar__button">&gt;</button>
    </div>
    <table class="calendar__body">
      <thead class="calendar__weekdays">
        <tr>
          <% for(const day of ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]) { %>
          <th class="cell weekday"><%= day %></th>
          <% } %>
        </tr>
      </thead>
      <tbody class="calendar__dates">
        <% for(let week = 0; week < 6; week++) { %>
        <tr>
          <% for(let dow = 0; dow < 7; dow++) { %>
          <td class="cell date"></td>
          <% } %>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <script src="main.js" defer></script>
</body>

</html>
